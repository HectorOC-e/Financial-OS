// FinancialOS — Prisma schema (datasource + generator only at Phase 1).
// The full entity model (Tenant, User, Profiles, Membership, Account, Contribution*,
// Shared*, AuditEntry, OutboxEvent) with BigInt money, `version` columns, and RLS is
// added in Phase 2 (tasks.md T014–T016) per data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
